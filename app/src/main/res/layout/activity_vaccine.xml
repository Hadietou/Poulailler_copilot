<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Suivi Sanitaire"
                app:titleTextColor="@color/white"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="@color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Guide de Prophylaxie Amélioré -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#1E90FF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONSEILS ET VACCINATION (AFRIQUE DE L'OUEST)"
                        android:textColor="#1E90FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- Plan de Vaccination -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plan type (Mauritanie, Sénégal, Mali, CI)"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvProphylaxisInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Logique Éclairage -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLightingLogic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lighting_logic_title"
                            android:textColor="@color/emerald_soft"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvLightingLogic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/lighting_logic_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bonnes Pratiques -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bonnes Pratiques de Biosécurité"
                            android:textColor="#FFD700"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvGoodPractices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:text="• Vide sanitaire : Respectez 2 semaines minimum.\n• Désinfection : Utilisez du grésil ou de la chaux.\n• Eau de boisson : Toujours propre et fraîche.\n• Visites : Limitez l'accès aux étrangers au poulailler.\n• Pédiluve : Installez un bac de désinfection à l'entrée." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Historique -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#4CAF50" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HISTORIQUE DES SOINS"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVaccineHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_vaccine" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Afficher plus"
                    android:textColor="#87CEEB"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddVaccine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#4CAF50"
            app:tint="@color/white"
            android:contentDescription="Ajouter un soin" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/accent_blue"
        app:itemTextColor="@color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
