<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Suivi Sanitaire"
                app:titleTextColor="@color/white"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="@color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#4CAF50"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nom du vaccin / médicament"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginBottom="12dp"
                            app:hintTextColor="#B0B0B0"
                            app:boxStrokeColor="#4CAF50"
                            app:startIconDrawable="@android:drawable/ic_menu_add"
                            app:startIconTint="#4CAF50">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVaccineName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="Date: Aujourd'hui"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/white"
                            app:strokeColor="#B0B0B0"
                            app:icon="@android:drawable/ic_menu_my_calendar"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Remarques (Lot, dose, etc.)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginBottom="24dp"
                            app:hintTextColor="#B0B0B0"
                            app:boxStrokeColor="#4CAF50">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etRemarks"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveVaccine"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:text="ENREGISTRER LE SOIN"
                            android:backgroundTint="#4CAF50"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            app:icon="@android:drawable/ic_menu_save"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Guide de Prophylaxie -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guide de Prophylaxie"
                    android:textColor="#1E90FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp">
                    <TextView
                        android:id="@+id/tvProphylaxisInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textColor="#B0B0B0"
                        android:text="Chargement du guide..." />
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Historique -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#87CEEB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Historique des Soins"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#87CEEB"
                            android:layout_marginBottom="16dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewVaccineHistory"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="AFFICHER L'HISTORIQUE"
                            app:cornerRadius="8dp"
                            app:icon="@android:drawable/ic_menu_recent_history"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="#87CEEB"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hidden for VM compatibility -->
                <ListView android:id="@+id/lvVaccines" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/accent_blue"
        app:itemTextColor="@color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
