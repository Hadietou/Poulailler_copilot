<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Suivi Sanitaire"
                app:titleTextColor="@color/white"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="@color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section Calendrier de Santé -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHealthCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/emerald_soft"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CALENDRIER DE SANTÉ"
                            android:textColor="@color/emerald_soft"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_margin="8dp"/>
                        <CalendarView
                            android:id="@+id/calendarView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:theme="@style/Theme.AppCompat.DayNight" />
                        <TextView
                            android:id="@+id/tvSelectedDayReminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:background="#22FFFFFF"
                            android:layout_margin="8dp"
                            tools:text="Alertes pour ce jour :\n• Newcastle (ND)"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Ration Alimentaire -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedRation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#FFD700"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RATION ALIMENTAIRE"
                            android:textColor="#FFD700"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Définissez la ration journalière par sujet (en grammes) pour ajuster le calcul du stock."
                            android:textColor="#B0B0B0"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Ration (g/sujet)"
                                app:hintTextColor="#B0B0B0"
                                app:boxStrokeColor="#FFD700"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFeedRation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveRation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="VALIDER"
                                app:cornerRadius="8dp"
                                android:backgroundTint="#FFD700"
                                android:textColor="@color/black" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Plan de Vaccination -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guide de Prophylaxie (Plan type)"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvProphylaxisInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Météo Nouakchott -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#FF8C00"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MÉTÉO NOUAKCHOTT (5 JOURS)"
                            android:textColor="#FF8C00"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <ProgressBar
                            android:id="@+id/weatherProgressBar"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"/>
                        <TextView
                            android:id="@+id/tvWeatherInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:text="Chargement de la météo..." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Logique Éclairage -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLightingLogic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lighting_logic_title"
                            android:textColor="@color/emerald_soft"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvLightingLogic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/lighting_logic_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bonnes Pratiques -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#222222"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bonnes Pratiques de Biosécurité"
                            android:textColor="#FFD700"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:id="@+id/tvGoodPractices"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:text="• Vide sanitaire : Respectez 2 semaines minimum.\n• Désinfection : Utilisez du grésil ou de la chaux.\n• Eau de boisson : Toujours propre et fraîche.\n• Visites : Limitez l'accès aux étrangers au poulailler.\n• Pédiluve : Installez un bac de désinfection à l'entrée." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section Historique -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#4CAF50" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HISTORIQUE DES SOINS"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVaccineHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_vaccine" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Afficher plus"
                    android:textColor="#87CEEB"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddVaccine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#4CAF50"
            app:tint="@color/white"
            android:contentDescription="Ajouter un soin" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/accent_blue"
        app:itemTextColor="@color/white"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
