<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Ma Ferme"
                app:titleTextColor="@color/white"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="@color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section Ration Alimentaire -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedRation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#111111"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#FFD700"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RATION ALIMENTAIRE"
                            android:textColor="#FFD700"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Définissez la ration journalière par sujet (en grammes) pour ajuster le calcul du stock."
                            android:textColor="#B0B0B0"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Ration (g/sujet)"
                                app:hintTextColor="#B0B0B0"
                                app:boxStrokeColor="#FFD700"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFeedRation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveRation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="VALIDER"
                                app:cornerRadius="8dp"
                                android:backgroundTint="#FFD700"
                                android:textColor="@color/black" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mode Affichage Amélioré -->
                <LinearLayout
                    android:id="@+id/layoutDisplayInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A1A1A"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#1E90FF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Résumé de l'exploitation"
                                android:textColor="#1E90FF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="16dp"/>

                            <!-- Farm Name -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_menu_my_calendar"
                                    app:tint="#1E90FF"
                                    android:contentDescription="Icône ferme" />
                                <TextView
                                    android:id="@+id/tvDisplayFarmName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:layout_marginStart="12dp"
                                    android:textStyle="bold"
                                    android:text="Nom de la ferme"/>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="8dp"/>

                            <!-- Hens Count & Breed (Hiding these in layout as they move to Batch) -->
                            <GridLayout
                                android:id="@+id/layoutDisplayBatchInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:visibility="gone">
                                <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Effectif initial" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                    <TextView android:id="@+id/tvDisplayHensCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                                </LinearLayout>
                                <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Race" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                    <TextView android:id="@+id/tvDisplayBreed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                                </LinearLayout>
                            </GridLayout>

                            <View android:id="@+id/divider1" android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="8dp" android:visibility="gone"/>

                            <!-- Dates (Hiding these in layout as they move to Batch) -->
                            <GridLayout
                                android:id="@+id/layoutDisplayDateInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:visibility="gone">
                                <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arrivée" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                    <TextView android:id="@+id/tvDisplayArrival" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="14sp"/>
                                </LinearLayout>
                                <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Naissance" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                    <TextView android:id="@+id/tvDisplayBirth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="14sp"/>
                                </LinearLayout>
                            </GridLayout>

                            <View android:id="@+id/divider2" android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="8dp" android:visibility="gone"/>

                            <!-- Currency Display -->
                            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monnaie utilisée" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvDisplayCurrency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:text="MRU"/>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="8dp"/>

                            <!-- Locality Display -->
                            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Localité (pour la météo)" android:textColor="#B0B0B0" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvDisplayLocality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:text="Non définie"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Seuils d'alerte (résumé) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="#1A1A1A"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="#1E90FF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Seuils d'alerte"
                                android:textColor="#1E90FF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:id="@+id/tvDisplayThresholds"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp"
                                tools:text="Stock alvéoles critique : 50\nStock aliment : critique &lt; 5j, alerte &lt; 10j\nCanicule : 35°C\nPhotopériode : 15h après le lever du soleil\nRappels vaccins : tous les 2 mois\nDéparasitage interne : tous les 3 mois\nDéparasitage externe : tous les 2 mois" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditInfo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="MODIFIER LES INFORMATIONS"
                        android:layout_marginTop="12dp"
                        app:cornerRadius="8dp"
                        app:icon="@android:drawable/ic_menu_edit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="#1E90FF"
                        app:strokeColor="#1E90FF"/>
                </LinearLayout>

                <!-- Mode Saisie/Modification -->
                <LinearLayout
                    android:id="@+id/layoutEditInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuration de la ferme"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nom de la ferme"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFarmName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilHensCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de poules au depart"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHensCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilHenBreed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Race des poules"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHenBreed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilArrivalDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date d'arrivée"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etArrivalDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBirthDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date de naissance"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Localité (ville/village)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:hintTextColor="@color/white"
                            app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLocality"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickOnMap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="CARTE"
                            app:icon="@android:drawable/ic_dialog_map"
                            app:cornerRadius="8dp"
                            android:backgroundTint="#1E90FF" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPickedLocationSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aucune position précise définie (météo par défaut : Nouakchott)"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="24dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCurrency"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Choix Monnaie"
                        android:layout_marginBottom="24dp"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white">
                        <AutoCompleteTextView
                            android:id="@+id/actvCurrency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seuils d'alerte"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Alvéoles critique (nb)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEggTraysCritical" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Canicule (°C)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginStart="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHeatAlertTemp" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Correction météo locale (°C)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp"
                        app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWeatherTempOffset" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="numberSigned|numberDecimal" android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="À ajuster si la météo affichée diffère du relevé de terrain (ex : +2 si la prévision est systématiquement trop basse)."
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Aliment critique (jours)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFeedStockCriticalDays" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Aliment alerte (jours)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginStart="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFeedStockWarningDays" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Photopériode (h)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLightingHours" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Vaccins (mois)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginStart="6dp" android:layout_marginBottom="12dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etVaccineInterval" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Déparasitage interne (mois)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="6dp" android:layout_marginBottom="24dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDewormingInternalInterval" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:hint="Déparasitage externe (mois)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginStart="6dp" android:layout_marginBottom="24dp"
                            app:hintTextColor="@color/white" app:boxStrokeColor="@color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDewormingExternalInterval" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:textColor="@color/white" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveFarmInfo"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="ENREGISTRER"
                        android:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ANNULER"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="@color/white"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/text_secondary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
