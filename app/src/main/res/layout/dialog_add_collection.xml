<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#E6FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouvelle Collecte"
        android:textColor="@color/accent_amber"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectDate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Date: Aujourd'hui"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/text_primary"
        app:strokeColor="@color/text_secondary"
        app:icon="@android:drawable/ic_menu_my_calendar"
        app:iconTint="@color/accent_amber"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre d'œufs collectés"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_amber"
        app:startIconDrawable="@android:drawable/ic_input_add"
        app:startIconTint="@color/accent_amber">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEggsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre d'œufs cassés"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_amber"
        app:startIconDrawable="@android:drawable/ic_delete"
        app:startIconTint="@color/error">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBrokenEggsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Remarques (poules malades, etc.)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="24dp"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_amber">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddEntry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ENREGISTRER LA COLLECTE"
        android:backgroundTint="@color/accent_amber"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconTint="@color/black"/>
</LinearLayout>
