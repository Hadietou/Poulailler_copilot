<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#2C2C2C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouvelle Collecte"
        android:textColor="#FFB300"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectDate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Date: Aujourd'hui"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/white"
        app:strokeColor="#B0B0B0"
        app:icon="@android:drawable/ic_menu_my_calendar"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre d'œufs collectés"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp"
        app:hintTextColor="#B0B0B0"
        app:boxStrokeColor="#FFB300"
        app:startIconDrawable="@android:drawable/ic_input_add"
        app:startIconTint="#FFB300">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEggsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre d'œufs cassés"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp"
        app:hintTextColor="#B0B0B0"
        app:boxStrokeColor="#FFB300"
        app:startIconDrawable="@android:drawable/ic_delete"
        app:startIconTint="#F44336">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBrokenEggsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Remarques (poules malades, etc.)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="24dp"
        app:hintTextColor="#B0B0B0"
        app:boxStrokeColor="#FFB300">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddEntry"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ENREGISTRER LA COLLECTE"
        android:backgroundTint="#FFB300"
        android:textColor="#000000"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconTint="#000000"/>
</LinearLayout>
