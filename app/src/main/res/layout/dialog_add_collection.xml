<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header"
        android:padding="16dp"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouvelle Collecte"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Date: Aujourd'hui"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/primary"
            app:icon="@drawable/ic_calendar"
            app:iconTint="@color/primary"
            android:layout_marginBottom="12dp"/>

        <!-- Saisie comme on la reçoit : plateaux complets + œufs restants (1 plateau = 30 œufs) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTrays"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Plateaux"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/primary">
                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.App.TextInputEditText"
                    android:id="@+id/etTrays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExtraEggs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="+ œufs"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/primary">
                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.App.TextInputEditText"
                    android:id="@+id/etExtraEggs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Total calculé en direct : permet de repérer une erreur de saisie avant d'enregistrer -->
        <TextView
            android:id="@+id/tvEggTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_value_chip"
            android:backgroundTint="@color/emerald_container"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Total : 0 œuf"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tilBroken"
            android:hint="Dont œufs cassés"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_marginBottom="12dp"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/primary"
            app:startIconDrawable="@drawable/ic_delete"
            app:startIconTint="@color/error">
            <com.google.android.material.textfield.TextInputEditText
        style="@style/Widget.App.TextInputEditText"
                android:id="@+id/etBrokenEggsCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remarques (poules malades, etc.)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_marginBottom="24dp"
            app:hintTextColor="@color/text_secondary"
            app:boxStrokeColor="@color/primary">
            <com.google.android.material.textfield.TextInputEditText
        style="@style/Widget.App.TextInputEditText"
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddEntry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ENREGISTRER LA COLLECTE"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/white"/>
    </LinearLayout>
</LinearLayout>
