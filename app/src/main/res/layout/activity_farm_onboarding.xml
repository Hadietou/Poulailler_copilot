<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bienvenue !"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Bienvenue, Amina !"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rejoignez une ferme ou créez la vôtre pour commencer."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"/>

        <!-- Invitations en attente -->
        <LinearLayout
            android:id="@+id/layoutInvitationsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVITATIONS EN ATTENTE"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:id="@+id/containerInvitations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- Utilisateur ayant déjà une ferme active (voir la note multi-fermes dans
             FirebaseRepository) : lui permettre de continuer sans traiter les invitations. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueToDashboard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Continuer vers mon tableau de bord"
            android:visibility="gone"
            tools:visibility="visible"/>

        <View
            android:id="@+id/dividerOrCreate"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/off_white"/>

        <TextView
            android:id="@+id/tvCreateFarmHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pas encore de ferme ?"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCreateFarmSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Créez votre propre ferme et invitez ensuite vos agents."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateFarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="🚜 CRÉER MA FERME"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/accent_amber"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Déconnexion"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>
