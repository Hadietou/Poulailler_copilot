<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.DashboardActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Kourkourou"
                app:titleTextColor="@color/text_primary"
                app:navigationIconTint="@color/text_primary"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section Alertes et Planification -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planification et Alertes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.App.CardView">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Prochain Vaccin -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_info_details"
                                android:contentDescription="Vaccin"
                                app:tint="#1E90FF" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prochain Vaccin / Soin" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvNextVaccine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chargement..." android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Autonomie Aliment -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_gallery"
                                android:contentDescription="Stock"
                                app:tint="#FFB300" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Autonomie Stock Aliment" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvFeedAutonomy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- jours restants" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Statistiques Troupeau -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Troupeau et Santé"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.App.CardView">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Poules"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvHensCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_amber"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMortality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        style="@style/Widget.App.CardView"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mortalité"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvTotalMortality"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/error"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        style="@style/Widget.App.CardView">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Âge (S)"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvHensAge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_green"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStockFeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.App.CardView"
                        android:clickable="true"
                        android:focusable="true">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aliment"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/tvTotalFeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 kg"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_amber"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Section Taux de Mortalité Cumulé -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCumulativeMortality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.App.CardView">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Taux de mortalité cumulé"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/tvCumulativeMortalityRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0%"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Statistiques Production -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Production d'Œufs"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.App.CardView">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Production du jour"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="14sp"/>
                                <TextView
                                    android:id="@+id/tvTodayEggs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 œufs"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Taux de ponte"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tvLayingRate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0%"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginVertical="20dp"/>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:alignmentMode="alignMargins">

                            <LinearLayout
                                android:id="@+id/layoutTotalCollected"
                                android:orientation="vertical"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="16dp"
                                android:clickable="true"
                                android:focusable="true">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Collectés total" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvTotalCollected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/accent_blue"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutTotalBroken"
                                android:orientation="vertical"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="16dp"
                                android:clickable="true"
                                android:focusable="true">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cassés total" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvTotalBroken" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/error"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutTotalSold"
                                android:orientation="vertical"
                                android:layout_columnWeight="1"
                                android:layout_marginBottom="16dp"
                                android:clickable="true"
                                android:focusable="true">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vendus total" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvTotalSold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/accent_green"/>
                            </LinearLayout>

                            <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_marginBottom="16dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restants" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvTotalRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/accent_rose"/>
                            </LinearLayout>

                            <LinearLayout android:orientation="vertical" android:layout_columnWeight="1">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taux 5 derniers j." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvLayingRate5d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/accent_rose"/>
                            </LinearLayout>

                            <LinearLayout android:orientation="vertical" android:layout_columnWeight="1">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taux de casse %" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                                <TextView android:id="@+id/tvBrokenRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/error"/>
                            </LinearLayout>
                        </GridLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginVertical="20dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Taux de ponte des 5 derniers jours"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"/>

                        <TableLayout
                            android:id="@+id/tableLast5Days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="0,1,2,3,4,5"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/divider"
                            android:layout_marginVertical="20dp"/>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/productionChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Statistiques Financières -->
                <LinearLayout
                    android:id="@+id/layoutFinanceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Résumé Financier"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Net Profit Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.App.CardView">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Bénéfice Net"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"/>
                            <TextView
                                android:id="@+id/tvNetProfit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_green"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardSalesRevenue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.App.CardView"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ventes"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tvSalesRevenue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 $"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardTotalExpenses"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            style="@style/Widget.App.CardView"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dépenses"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"/>
                                <TextView
                                    android:id="@+id/tvTotalExpenses"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 $"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/error"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        style="@style/Widget.App.CardView">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dépenses par catégorie"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="16dp"/>

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/expensesBarChart"
                                android:layout_width="match_parent"
                                android:layout_height="250dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/accent_blue"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
