<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.DashboardActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── APPBAR ── -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                app:navigationIconTint="@color/white"
                app:title="@string/app_name"
                app:titleTextColor="@color/white">
                <include layout="@layout/header_icons" />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ── SCROLL CONTENT ── -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ══════════════════════════════════════════
                     HERO HEADER — Identité & Alertes
                ══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/primary"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="#B2FFB2"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvDashboardBatchName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/current_batch"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:id="@+id/ivSelectBatch"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:alpha="0.7"
                            app:tint="@color/white" />
                        <Spinner android:id="@+id/spinnerBatches" android:layout_width="0dp" android:layout_height="0dp" android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Carte Effectif & Âge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#4DFFFFFF"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_heart" app:tint="@color/white" />
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sujets" android:textColor="#B2FFB2" android:textSize="9sp" android:textAllCaps="true" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvDashboardHensCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                            <View android:layout_width="1dp" android:layout_height="30dp" android:background="#4DFFFFFF" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:gravity="center">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_my_calendar" app:tint="@color/white" />
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Âge actuel" android:textColor="#B2FFB2" android:textSize="9sp" android:textAllCaps="true" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvDashboardAge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Rangée Statut Rapide (Petites cartes réordonnées) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Stock Aliment (Priorité 1) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardFeedStockCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/earthy_orange"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_feed" app:tint="@color/white" />
                                    <TextView android:id="@+id/tvFeedStockCircleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" tools:text="Stock : 12j" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Stock Œufs (Priorité 2) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardStockCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/accent_blue"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_egg" app:tint="@color/white" />
                                    <TextView android:id="@+id/tvStockCircleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" tools:text="24 Tab dispo" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Stock Alvéoles (Priorité 1.5) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardEggTraysStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="@color/accent_amber"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_egg" app:tint="@color/white" />
                                    <TextView android:id="@+id/tvEggTraysStockValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" tools:text="Alvéoles : 120" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Lumière (Position 3) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardLightingAlert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                app:cardBackgroundColor="#1AFFFFFF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="#FFD700" />
                                    <TextView android:id="@+id/tvLightingTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" tools:text="Lumière : 21:30" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Vaccin (Position 4) -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardSanitaryAlert"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#1AFFFFFF"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:paddingHorizontal="10dp" android:gravity="center_vertical">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_dialog_info" app:tint="#FFA0A0" />
                                    <TextView android:id="@+id/tvNextVaccine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" tools:text="Vaccin J10" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ── SECTION : RAPPELS DE SANTÉ ── -->
                <LinearLayout
                    android:id="@+id/layoutHealthReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/error_container"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="12dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_heart"
                                    app:tint="@color/error" />

                                <TextView
                                    android:id="@+id/tvHealthRemindersSummary"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:textColor="@color/error"
                                    android:textStyle="bold"
                                    android:textSize="14sp"
                                    tools:text="3 rappels de santé en attente" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnToggleReminders"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Détails"
                                    android:textColor="@color/primary" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvHealthReminders"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingBottom="8dp"
                                android:visibility="gone"
                                android:nestedScrollingEnabled="false"
                                tools:listitem="@layout/item_health_reminder"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── SECTION 1 : PERFORMANCE DU JOUR ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="PERFORMANCE DU JOUR"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLayingRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@color/emerald_container"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                    <com.google.android.material.progressindicator.CircularProgressIndicator
                                        android:id="@+id/progressLayingRate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:indicatorSize="80dp"
                                        app:trackThickness="8dp"
                                        app:indicatorColor="@color/emerald_soft"
                                        app:trackColor="@color/emerald_container" />
                                    <TextView android:id="@+id/tvLayingRateValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold" tools:text="85%" />
                                </FrameLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taux de ponte" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvTodayEggsDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" tools:text="120 œufs collectés" />
                                    <TextView android:id="@+id/tvLayingTrend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:background="@drawable/bg_trend_chip" android:textSize="11sp" android:textStyle="bold" tools:text="▲ +2% vs hier" />
                                </LinearLayout>
                            </LinearLayout>
                            <!-- Graphique intégré à la performance -->
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background" android:layout_marginVertical="16dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Évolution (15 derniers jours)" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/productionChart"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── SECTION : BILAN DU MOIS (GRID) ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="BILAN DU MOIS"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#EEE"
                        app:strokeWidth="1dp">
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="3"
                            android:padding="8dp">
                            <!-- Sains -->
                            <LinearLayout android:id="@+id/layoutMonthlyCollected" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_egg" app:tint="@color/emerald_soft" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAINS" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlyCollectedTablettes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald_soft" android:textSize="14sp" android:textStyle="bold" tools:text="45 Tab" />
                            </LinearLayout>
                            <!-- Ventes -->
                            <LinearLayout android:id="@+id/layoutMonthlySold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_send" app:tint="@color/earthy_orange" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VENTES" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlySoldTablettes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/earthy_orange" android:textSize="14sp" android:textStyle="bold" tools:text="38 Tab" />
                            </LinearLayout>
                            <!-- Recette -->
                            <LinearLayout android:id="@+id/layoutMonthlyRevenue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_finance" app:tint="@color/emerald_soft" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECETTE" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlySalesAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald_soft" android:textSize="14sp" android:textStyle="bold" tools:text="12k MRU" />
                            </LinearLayout>
                            <!-- Cassés -->
                            <LinearLayout android:id="@+id/layoutMonthlyBroken" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_egg" app:tint="@color/error" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASSÉS" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlyBroken" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="14sp" android:textStyle="bold" tools:text="15" />
                            </LinearLayout>
                            <!-- Morts -->
                            <LinearLayout android:id="@+id/layoutMonthlyMortality" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_heart" app:tint="@color/error" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MORTS" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlyMortality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="14sp" android:textStyle="bold" tools:text="3" />
                            </LinearLayout>
                            <!-- Dépenses -->
                            <LinearLayout android:id="@+id/layoutMonthlyExpenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:background="?attr/selectableItemBackground" android:clickable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_finance" app:tint="@color/earthy_orange" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DÉPENSES" android:textColor="@color/text_secondary" android:textSize="8sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvMonthlyExpensesAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/earthy_orange" android:textSize="14sp" android:textStyle="bold" tools:text="8.5k MRU" />
                            </LinearLayout>
                        </GridLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── SECTION : SANTÉ & TECHNIQUE ── -->
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="SANTÉ &amp; TECHNIQUE" android:textColor="@color/error" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTechHealth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:strokeColor="@color/error_container" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Taux Survie" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvSurvivalRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald_soft" android:textSize="16sp" android:textStyle="bold" tools:text="98.5%" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indice Conso (IC)" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvICValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="2.14" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Écart Std" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvGapStdValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="16sp" android:textStyle="bold" tools:text="-4.2%" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── SECTION : ALIMENTATION ── -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="ALIMENTATION" android:textColor="@color/earthy_orange" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:strokeColor="@color/earthy_container" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stock Restant" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvStockAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald_soft" android:textSize="16sp" android:textStyle="bold" tools:text="450 kg" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Autonomie" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvFeedAutonomyDashboard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/earthy_orange" android:textSize="16sp" android:textStyle="bold" tools:text="12 jours" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conso/Poule" android:textColor="@color/text_secondary" android:textSize="10sp" />
                                    <TextView android:id="@+id/tvConsumptionPerHen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="115 g" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ── SECTION : BILAN FINANCIER ── -->
                    <TextView android:id="@+id/titleFinance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="SITUATION FINANCIÈRE" android:textColor="@color/accent_blue" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNetProfit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="20dp" app:strokeColor="@color/accent_blue_container" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bénéfice Net Global" android:textColor="@color/emerald_soft" android:textSize="12sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvNetProfit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" tools:text="45,000 MRU" />
                                </LinearLayout>
                                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_finance" app:tint="@color/accent_blue" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background" android:layout_marginVertical="12dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Entrées" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvTotalRevenueValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald_soft" android:textSize="16sp" android:textStyle="bold" tools:text="150,000 MRU" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Dépenses" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/tvTotalExpensesValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="16sp" android:textStyle="bold" tools:text="105,000 MRU" />
                                </LinearLayout>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/background" android:layout_marginVertical="12dp" />

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Répartition des dépenses par catégorie" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                            <com.github.mikephil.charting.charts.BarChart
                                android:id="@+id/expensesBarChart" android:layout_width="match_parent" android:layout_height="200dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Éléments invisibles techniques conservés pour le binding du DashboardActivity.kt -->
                    <TextView android:id="@+id/tvTotalCollectedTablettes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalCollectedEggs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalSoldTablettes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalSoldEggs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvAvailableTablettes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvAvailableEggs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyProdValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlySalesValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyRateValue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalMortalityTech" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyMortalityTech" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyProdTrend" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlySalesTrend" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyRateTrend" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlyCollectedEggs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvMonthlySoldEggs" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvCumulMortalityRate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvDailyConsumption" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalConsumed" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalFeedCostSection" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalRevenue" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvTotalExpenses" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

