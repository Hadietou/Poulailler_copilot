<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestion des Agents"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Section Création -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEEE"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etAgentUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom d'utilisateur"
            android:background="#008000"
            android:padding="12dp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etAgentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:background="#008000"
            android:padding="12dp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCreateAgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CRÉER L'AGENT" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvAgents"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:choiceMode="singleChoice" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnToggleActive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Activer/Désactiver"
            android:textSize="11sp"/>
        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset PWD (1234)"
            android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historique des connexions"
        android:textStyle="bold"
        android:background="#008000"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lvGlobalHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Éléments masqués mais gardés pour compatibilité VM si besoin -->
    <View android:id="@+id/btnSaveFarmInfo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <EditText android:id="@+id/etHensCount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <EditText android:id="@+id/etFeedInfo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <EditText android:id="@+id/etMortality" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <EditText android:id="@+id/etExpenses" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/tvStats" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/btnRefreshStats" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
