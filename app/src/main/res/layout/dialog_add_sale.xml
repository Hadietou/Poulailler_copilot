<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header"
        android:padding="16dp"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nouvelle Vente"
            android:textColor="@color/primary_variant"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date de la vente"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#CCFFFFFF"
            app:boxStrokeColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
            app:startIconTint="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaleDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de tablettes vendues"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#CCFFFFFF"
            app:boxStrokeColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_input_add"
            app:startIconTint="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUnitPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prix par tablette"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#CCFFFFFF"
            app:boxStrokeColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_menu_agenda"
            app:startIconTint="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUnitPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom du client (Optionnel)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp"
            app:hintTextColor="#CCFFFFFF"
            app:boxStrokeColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuyer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Numéro de téléphone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="24dp"
            app:hintTextColor="#CCFFFFFF"
            app:boxStrokeColor="@color/white"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="@color/white">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSale"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="VALIDER LA VENTE"
            android:backgroundTint="@color/white"
            android:textColor="@color/primary_variant"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/primary_variant"/>
    </LinearLayout>
</LinearLayout>
